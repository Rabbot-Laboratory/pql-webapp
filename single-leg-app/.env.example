# Linux / Raspberry Pi example
SINGLE_LEG_PORT_NAME=/dev/ttyUSB-Leg

# Windows example: SINGLE_LEG_PORT_NAME=COM3
SINGLE_LEG_SERIAL_BAUDRATE=115200
SINGLE_LEG_API_PORT=8100
SINGLE_LEG_EMULATE_DEVICES=false

# ESP32 protocol always carries four fields. Channels 2/3 are not shown or monitored.
SINGLE_LEG_UNUSED_POSITION=2048
SINGLE_LEG_UNUSED_COMMAND=900

